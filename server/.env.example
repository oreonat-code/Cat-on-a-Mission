PORT=5000
# Project URL only, e.g. https://abcd1234.supabase.co (no /rest/v1 on the end)
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...), never the publishable key
SUPABASE_SERVICE_KEY=your-secret-key
# Signs login cookies. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me
